# Copy to .env and fill in real keys; .env is gitignored and must never enter the public repo.
# Tavily: free signup at app.tavily.com, the console generates a tvly- key directly
# (1000 free credits per month).
TAVILY_API_KEY=

# Nebius Token Factory: tokenfactory.nebius.com -> avatar -> API Keys -> Create API Key
# Variable names MUST use LLM_*: without LLM_BASE_URL llm.py falls back to the default
# endpoint (Nebius itself); without LLM_API_KEY it raises. Writing NEBIUS_API_KEY would
# silently go unread and cost you the scoring item for real Token Factory usage.
LLM_BASE_URL=https://api.tokenfactory.nebius.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-ai/DeepSeek-V4.1-Flash-1017
