# 复制为 .env 并填入真实 key；.env 已被 .gitignore 排除，绝不进公开仓库
# Tavily：app.tavily.com 免费注册后，控制台直接生成 tvly- 开头的 key（每月 1000 次免费额度）
TAVILY_API_KEY=

# Nebius Token Factory：tokenfactory.nebius.com → 头像 → API Keys → Create API Key
# 变量名必须用 LLM_*：llm.py 读不到 LLM_BASE_URL 时退回默认端点（即 Nebius 本身），
# 读不到 LLM_API_KEY 则报错；写成 NEBIUS_API_KEY 不会被读取，评分第 5 项会丢分。
LLM_BASE_URL=https://api.tokenfactory.nebius.com/v1
LLM_API_KEY=
LLM_MODEL=MiniMaxAI/MiniMax-M3
