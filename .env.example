# 复制为 .env并填入真实key；.env已被.gitignore排除，绝不进公开仓库
# Tavily：app.tavily.com免费注册后，控制台直接生成tvly-开头的key（每月1000次免费额度）
TAVILY_API_KEY=

# Nebius Token Factory：tokenfactory.nebius.com → 头像 → API Keys → Create API Key
# 变量名必须用LLM_*：llm.py读不到LLM_BASE_URL时退回默认端点（即Nebius本身），
# 读不到LLM_API_KEY则报错；写成NEBIUS_API_KEY不会被读取，评分第5项会丢分。
LLM_BASE_URL=https://api.tokenfactory.nebius.com/v1
LLM_API_KEY=
LLM_MODEL=MiniMaxAI/MiniMax-M3
